# Every setting for Paribelle on the ThinkPad, in one file. It becomes infra/.env (never
# committed). Keep a copy in your password manager. compose.yml hands each app only its own.
#
# "Same as Render" / "same as Vercel": the fallback must have the identical value, or people
# are signed out, or payments fail, when a request moves from one side to the other.

# ---- The stack ------------------------------------------------------------------------------

# GitHub › Settings › Developer settings › Personal access tokens › Tokens (classic):
# only read:packages. The images are private; update.sh logs in with this.
GHCR_USER=anubhav-qt
GHCR_TOKEN=

# The ThinkPad's Postgres. openssl rand -hex 24
DB_PASSWORD=

# Cloudflare Zero Trust › Networks › Tunnels › paribelle-thinkpad: the token after --token.
TUNNEL_TOKEN=

# Only the edge Worker has it, and the gate lets nothing else in. openssl rand -hex 32
# The same value is the Worker's EDGE_KEY secret and Render's EDGE_KEY.
EDGE_KEY=

# ---- The cloud copies (Supabase › the project › Connect › Session pooler, port 5432) --------

# The API's database (Render's DATABASE_URL, the Singapore project).
SHOP_CLOUD_URL=
# The OMS's database (the Mumbai project).
OMS_CLOUD_URL=

# ---- The API: same as Render ----------------------------------------------------------------

JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
# Only if Render sets them: the mail sender, the admin's address, the seller on invoices.
SMTP_FROM=
ADMIN_EMAIL=
APP_NAME=
APP_ADDRESS=
APP_EMAIL=
APP_PHONE=
APP_GST=
# The site's addresses default to the production ones (compose.yml); set these only to change them:
# ALLOWED_ORIGINS=https://www.paribelle.in,https://paribelle.in
# FRONTEND_URL=https://www.paribelle.in
# WEB_APP_URL=https://www.paribelle.in
# APP_URL=https://www.paribelle.in

# ---- The storefront: same as Vercel -----------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- The OMS: same as Vercel ------------------------------------------------------------------

AUTH_SECRET=
# Only between the ThinkPad and its own OMS (the 10-minute order sync). openssl rand -hex 32
CRON_SECRET=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=
GEMINI_REEL_MODELS=

# ---- Backups and monitoring -----------------------------------------------------------------

# The public half of the backup key (age1…). The private half is never on the ThinkPad.
BACKUP_RECIPIENT=
# Cloudflare R2 › Manage API tokens › Object Read & Write on the paribelle-backups bucket.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Healthchecks.io: pinged every 5 minutes while both databases are synced and serving.
HEARTBEAT_URL=

# ---- Tuning (optional) ----------------------------------------------------------------------

# Processes for the storefront and the OMS: auto is one per core, up to 8.
# WEB_PROCESSES=auto
# OMS_PROCESSES=auto
# Past this size a Supabase database has its oldest rows removed (sync/policy.json).
# The ThinkPad keeps them. The free plan allows 500 MB.
# PRUNE_AT_MB=400
