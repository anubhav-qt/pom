# Settings for infra/ship.sh. Copy to infra/.env.ship (never committed) and fill in.

# The storefront's repositories, relative to POM's folder.
WEB_DIR=../paribelle/marketplace-web
API_DIR=../paribelle/marketplace-backend

# The ThinkPad's filled-in infra/.env, for the deploy hook's key (derived from its EDGE_KEY;
# only the derived key is sent). Or put that key in THINKPAD_DEPLOY_KEY instead.
THINKPAD_ENV=
THINKPAD_DEPLOY_KEY=

# Only for shipping the edge Worker (infra/edge): a Cloudflare API token that can edit
# Workers scripts and routes on paribelle.in.
CLOUDFLARE_API_TOKEN=
