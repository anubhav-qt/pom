# ---------------------------------------------------------------------------
# Database — Neon Postgres (free tier is enough for ~4k orders/month)
# Create a project at https://console.neon.tech and paste the pooled conn string
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/oms?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing. Generate with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Cron protection. Vercel Cron sends this as an Authorization: Bearer header.
# ---------------------------------------------------------------------------
CRON_SECRET="another-long-random-string"

# ---------------------------------------------------------------------------
# Amazon SP-API  (Seller Central > Apps & Services > Develop Apps)
# Register a *private* app against your own seller account; no AWS IAM role is
# needed since the 2023 auth change — LWA credentials alone are sufficient.
# ---------------------------------------------------------------------------
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
# Marketplace + endpoint for India
AMAZON_MARKETPLACE_ID="A21TJRUUN4KGV"
AMAZON_SPAPI_ENDPOINT="https://sellingpartnerapi-eu.amazon.com"

# Per-account refresh token is stored in the DB (channel_accounts.credentials),
# not here — so multiple seller accounts can be connected.

# ---------------------------------------------------------------------------
# Flipkart Seller API
# Seller Dashboard > Manage Profile > Developer Access > create self-access app
# ---------------------------------------------------------------------------
FLIPKART_API_BASE="https://api.flipkart.net"

# appId / appSecret are stored per channel account in the DB.

# ---------------------------------------------------------------------------
# Meesho — no self-serve API. Orders and labels are imported from the supplier
# panel exports. Nothing to configure here.
# ---------------------------------------------------------------------------
